# ---------------------------------------------------------------
# Altium Designer
# ---------------------------------------------------------------

# Local history (auto-saved revisions of every document)
History/
**/History/

# Generated previews, logs and outputs
__Previews/
Project Logs for */
# "Project Outputs for */" is NOT ignored here: the BOM, PDFs and STEP are committed on purpose

# Per-user / per-workspace state
*.PrjPcbStructure.bak
*.SchDocPreview
*.PcbDocPreview
*.PrjPcbVariants.bak
*.dsnwrk
*.DsnWrk
*.PrjGrpStructure

# Autosave, backup and lock files
*.$$$
*.~*
~$*
*.bak
*.Bak
*.BAK
*.lck
*.LOG
*.tmp

# Altium cache / temp folders
.vault/
**/Altium Temp/

# Access database lock file (created while a .mdb is open)
*.ldb
*.laccdb

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
.vscode/
.idea/

# ---------------------------------------------------------------
# SolidWorks
# ---------------------------------------------------------------
# Lock files (~$*) are covered above
*.SLDBAK
*.swbak

# Python
__pycache__/
*.pyc
